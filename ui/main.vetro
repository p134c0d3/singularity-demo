Template(class: "SingularityAppsDemoWindow", parent: "SingularityWidgetsWindow") {
    AppSidebar(id: "nav_sidebar", sidebarWidth: 220) {
        ListBox(id: "nav_list", vexpand: true, selectionMode: "single")
            .cssClass("navigation-sidebar")
    }

    VBox(id: "content_root", hexpand: true, vexpand: true) {
        Stack(id: "content_stack", hexpand: true, vexpand: true)
            .transitionType("crossfade")
    }
}
