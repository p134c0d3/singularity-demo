// Demo pages declared in vetro. Each top-level object has an id; window.vala
// loads them via Gtk.Builder, places them in the content stack, and wires any
// interactive/dynamic bits (segment options, etc.) by fetching ids.

ScrolledWindow(id: "controls_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, vexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 24) {
            Label(label: "Controls", halign: "start").cssClass("title-2")

            HBox(spacing: 12) {
                Label(label: "IconButton:", halign: "start", widthChars: 18).translatable("label")
                IconButton(icon: "folder-symbolic")
            }
            HBox(spacing: 12) {
                Label(label: "CircularButton:", halign: "start", widthChars: 18).translatable("label")
                CircularButton(icon: "starred-symbolic")
            }
            HBox(spacing: 12) {
                Label(label: "CloseButton:", halign: "start", widthChars: 18).translatable("label")
                CloseButton(icon: "window-close-symbolic")
            }
            HBox(spacing: 12) {
                Label(label: "ColorPickerButton:", halign: "start", widthChars: 18).translatable("label")
                ColorPickerButton()
            }
            HBox(spacing: 12) {
                Label(label: "QuickSettingTile:", halign: "start", widthChars: 18).translatable("label")
                QuickSettingTile(title: "Wi-Fi", iconName: "network-wireless-symbolic")
            }
            HBox(spacing: 12) {
                Label(label: "SearchEntry:", halign: "start", widthChars: 18).translatable("label")
                SingularityWidgetsSearchEntry(id: "controls_search", placeholderText: "Search…", hexpand: true)
            }
            HBox(spacing: 12) {
                Label(label: "SegmentedControl:", halign: "start", widthChars: 18).translatable("label")
                SegmentedControl(id: "controls_segment")
            }
        }
    }
}

ScrolledWindow(id: "prefgroup_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "PreferencesGroup", halign: "start").cssClass("title-2")

            PreferencesGroup(title: "Group with header suffix") {
                Button(iconName: "list-add-symbolic").cssClass("flat").asChildType("header-suffix")
                ActionRow(title: "Item one", subtitle: "subtitle here").translatable("title", "subtitle")
                SwitchRow(title: "Item two").translatable("title")
            }

            PreferencesGroup(title: "Group with description",
                             description: "Optional subtitle below the title") {
                EntryRow(title: "Name")
                EntryRow(title: "Value")
            }
        }
    }
}

ScrolledWindow(id: "navigation_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "Navigation", halign: "start").cssClass("title-2")
            Label(label: "SidebarSectionLabel:", halign: "start").translatable("label")
            SidebarSectionLabel(text: "Section Header")
            Label(label: "MenuRow:", halign: "start", marginTop: 12).translatable("label")
            MenuRow(labelText: "Open folder", iconName: "folder-symbolic").cssClass("card")
        }
    }
}

ScrolledWindow(id: "statuspage_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 24) {
            Label(label: "StatusPage", halign: "start").cssClass("title-2")
            StatusPage(iconName: "folder-symbolic", title: "No Files Found",
                       description: "Try a different search or create a new file.")
                .translatable("title", "description")
        }
    }
}

ScrolledWindow(id: "preference_rows_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 8) {
            Label(label: "Preference Rows", halign: "start", marginBottom: 16).cssClass("title-2")
            // Rows added imperatively in Vala (SelectionRow/SearchableExpanderRow
            // are not markup-friendly), so just declare the empty group here.
            PreferencesGroup(id: "preference_rows_group", title: "All Row Types").translatable("title")
        }
    }
}

ScrolledWindow(id: "preferences_page_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginStart: 24, marginEnd: 24) {
        Label(label: "PreferencesPage", halign: "start", marginBottom: 16).cssClass("title-2")
        ScrolledWindow(hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
            // Groups appended in Vala (g2 contains a SelectionRow).
            PreferencesPage(id: "preferences_page_inner")
        }
    }
}

ScrolledWindow(id: "preferences_window_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "PreferencesWindow", halign: "start", marginBottom: 16).cssClass("title-2")
            Label(label: "PreferencesWindow is a top-level Gtk.Window. Click the button to open it.",
                  wrap: true, halign: "start").translatable("label")
            Button(id: "preferences_window_open_btn", label: "Open PreferencesWindow", halign: "start")
                .translatable("label").cssClass("suggested-action")
        }
    }
}

ScrolledWindow(id: "window_info_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "Singularity.Widgets.Window", halign: "start", marginBottom: 16).cssClass("title-2")
            Label(label: "Singularity.Widgets.Window is the base window class for all Singularity apps.\n\nIt provides:\n  Custom ToolBar title bar\n  Rounded corners (settable via GSettings)\n  Session state persistence (position & size)\n  Clamp to work area on map\n  set_content() + header suffix support\n\nThis window is itself a Singularity.Widgets.Window.",
                  wrap: true, halign: "start", selectable: true).translatable("label")
        }
    }
}

ScrolledWindow(id: "toolbar_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "ToolBar", halign: "start", marginBottom: 16).cssClass("title-2")
            Label(label: "ToolBar is used inside Singularity.Widgets.Window as the custom title bar.\nIt provides back/forward buttons, a title, and suffix widget slots.\n\nThis demo window itself uses a ToolBar look at the top.",
                  wrap: true, halign: "start").translatable("label")
            Label(label: "ToolBar (standalone example):", halign: "start", marginTop: 12).translatable("label")
            ToolBar(id: "toolbar_demo_bar").cssClass("card")
        }
    }
}

ScrolledWindow(id: "dialogs_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "Dialogs", halign: "start", marginBottom: 16).cssClass("title-2")
            Label(label: "AppDialog is a lightweight modal window. Click below to open one.",
                  wrap: true, halign: "start").translatable("label")
            Button(id: "dialogs_open_btn", label: "Open AppDialog", halign: "start")
                .translatable("label").cssClass("suggested-action")
            Label(label: "ShellDialog is for shell-layer overlays (requires LayerShell context).",
                  wrap: true, halign: "start", marginTop: 12).translatable("label")
        }
    }
}

ScrolledWindow(id: "confirm_dialog_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "ConfirmDialog", halign: "start", marginBottom: 16).cssClass("title-2")
            Label(label: "ConfirmDialog: title + icon + description + primary/secondary actions.",
                  wrap: true, halign: "start").translatable("label")
            Button(id: "confirm_dialog_open_btn", label: "Open ConfirmDialog", halign: "start")
                .translatable("label").cssClass("suggested-action")
        }
    }
}

ScrolledWindow(id: "confirm_row_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "ConfirmRow", halign: "start", marginBottom: 16).cssClass("title-2")
            // ConfirmRow added imperatively in Vala (constructor-arg based).
            PreferencesGroup(id: "confirm_row_group", title: "Danger zone").translatable("title")
        }
    }
}

ScrolledWindow(id: "context_menu_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "ContextMenu", halign: "start", marginBottom: 16).cssClass("title-2")
            Label(label: "Right-click the button (or click it) to show a ContextMenu.",
                  wrap: true, halign: "start").translatable("label")
            Button(id: "context_menu_btn", label: "Show Context Menu", halign: "start").translatable("label")
        }
    }
}

ScrolledWindow(id: "chips_page", hscrollbarPolicy: "never", hexpand: true, vexpand: true) {
    VBox(hexpand: true, valign: "start",
         marginTop: 24, marginBottom: 32, marginStart: 24, marginEnd: 24) {
        VBox(spacing: 16) {
            Label(label: "Chips & ChipBar", halign: "start", marginBottom: 16).cssClass("title-2")
            Label(label: "Chip (standalone):", halign: "start").translatable("label")
            HBox(spacing: 8) {
                Chip(chipId: "active", chipLabel: "Active")
                Chip(chipId: "pending", chipLabel: "Pending")
                Chip(chipId: "done", chipLabel: "Done")
            }
            Label(label: "ChipBar:", halign: "start", marginTop: 16).translatable("label")
            // Chips added imperatively in Vala (ChipBar.add_chip).
            ChipBar(id: "chips_chipbar", hexpand: true)
        }
    }
}
